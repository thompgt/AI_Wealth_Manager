# Copy to `.env` and fill in. `.env` is gitignored.
#
# Every value here has a working default in config.py, so the system runs
# out of the box for local development -- but several of those defaults are
# deliberately unsafe for a real deployment, and the server refuses to start
# with them when ENVIRONMENT is not "development". See
# Settings.validate_for_environment.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# development | staging | production
# Anything other than "development" enforces: a non-default API key, a real
# Gemini key, and a non-SQLite database.
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite is fine for local work. Postgres (e.g. Neon) is required for any
# multi-worker deployment -- SQLite cannot safely serve concurrent writers.
NEON_DATABASE_URL=sqlite:///./wealth_manager.db
# NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
# WITHOUT a real key the system still runs end to end, but the Market Regime,
# Stock Research ranking and Finance Report agents all fall back to their
# deterministic paths: the regime call becomes "Volatile"/confidence 0.0,
# stock picks are ranked purely on relative valuation with confidence 0.0,
# and the report is a template. Output is produced either way -- check
# `llm_enabled` on GET /health to see which mode you are in.
GEMINI_API_KEY=DUMMY_API_KEY
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
LLM_BACKOFF_SECONDS=2.0

# ---------------------------------------------------------------------------
# API auth
# ---------------------------------------------------------------------------
# Shared secret checked against the X-API-Key header. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_AUTH_KEY=DEV_ONLY_CHANGE_ME
# Origins allowed to call the API from a browser (comma-separated).
CORS_ALLOW_ORIGINS=http://localhost:8765,http://localhost:8766

# ---------------------------------------------------------------------------
# Human-in-the-loop checkpoints
# ---------------------------------------------------------------------------
# Where paused runs are stored between the trigger request and the approval
# request. Ignored when NEON_DATABASE_URL points at Postgres (the Postgres
# checkpointer is used instead).
CHECKPOINT_DB_PATH=./checkpoints.sqlite

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------
RISK_FREE_RATE=0.04
LOOKBACK_PERIOD_YEARS=1
MARKET_DATA_CACHE_TTL_HOURS=24
TICKER_INFO_CACHE_TTL_MINUTES=60
